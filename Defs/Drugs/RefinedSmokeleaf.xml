<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="MakeableDrugBase">
    <defName>RefinedSmokeleafJoint</defName>
    <label>advanced smokeleaf joint</label>
    <description>A carefully processed smokeleaf joint with purified active compounds. Delivers the same euphoric high as regular smokeleaf with almost no impairment to consciousness and no effect on movement. Slightly wakes the mind and sharpens the appetite. Preferred by colonists who need to stay functional.</description>
    <descriptionHyperlinks>
      <HediffDef>RefinedSmokeleafHigh</HediffDef>
      <HediffDef>SmokeleafTolerance</HediffDef>
      <HediffDef>SmokeleafAddiction</HediffDef>
    </descriptionHyperlinks>
    <possessionCount>5</possessionCount>
    <graphicData>
      <texPath>Things/Item/RefinedSmokeleaf</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToMake>600</WorkToMake>
      <MarketValue>22</MarketValue>
      <Mass>0.05</Mass>
      <DeteriorationRate>6</DeteriorationRate>
      <Flammability>1.3</Flammability>
    </statBases>
    <techLevel>Industrial</techLevel>
    <ingestible>
      <foodType>Plant, Processed</foodType>
      <joyKind>Chemical</joyKind>
      <joy>0.80</joy>
      <baseIngestTicks>720</baseIngestTicks>
      <nurseable>true</nurseable>
      <drugCategory>Social</drugCategory>
      <ingestSound>Ingest_Smoke</ingestSound>
      <ingestEffect>Smoke_Joint</ingestEffect>
      <ingestEffectEat>EatVegetarian</ingestEffectEat>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestCommandString>Smoke {0}</ingestCommandString>
      <ingestReportString>Smoking {0}.</ingestReportString>
      <ingestReportStringEat>Consuming {0}.</ingestReportStringEat>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>RefinedSmokeleafHigh</hediffDef>
          <severity>1.0</severity>
          <toleranceChemical>Smokeleaf</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_OffsetNeed">
          <need>Rest</need>
          <offset>-0.1</offset>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>SmokeleafTolerance</hediffDef>
          <toleranceChemical>Smokeleaf</toleranceChemical>
          <severity>0.010</severity>
          <divideByBodySize>true</divideByBodySize>
          <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <workSpeedStat>DrugCookingSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
      <researchPrerequisite>SmokeleafRefinement</researchPrerequisite>
    </recipeMaker>
    <costList>
      <SmokeleafLeaves>8</SmokeleafLeaves>
    </costList>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>Smokeleaf</chemical>
        <addictiveness>0.015</addictiveness>
        <minToleranceToAddict>0.20</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.04</existingAddictionSeverityOffset>
        <needLevelOffset>0.6</needLevelOffset>
        <listOrder>1000</listOrder>
        <overdoseSeverityOffset>0.10~0.18</overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>

  <HediffDef>
    <defName>RefinedSmokeleafHigh</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>advanced smokeleaf high</label>
    <labelNoun>an advanced smokeleaf high</labelNoun>
    <description>A refined, smooth smokeleaf high. Still clear-headed, but appetite picks up.</description>
    <defaultLabelColor>(0.5, 1, 0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>-0.20</painOffset>
        <hungerRateFactorOffset>0.10</hungerRateFactorOffset>
        <restFallFactor>0.95</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>RefinedSmokeleafHigh</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>RefinedSmokeleafHigh</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>high on advanced smokeleaf</label>
        <description>I smoked some advanced smokeleaf. Smooth high, and I can still think straight. Maybe a little peckish.</description>
        <baseMoodEffect>13</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
